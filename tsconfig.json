{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*", "./worker-configuration.d.ts"],
	"exclude": ["dist"],
	"compilerOptions": {
		"paths": {
			"@pages/*": ["./src/pages/*"],
			"@styles/*": ["./src/styles/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@components/*": ["./src/components/*"],
			"@db/*": ["./src/db/*"]
		},
		"jsx": "preserve",
		"jsxImportSource": "solid-js"
	}
}
