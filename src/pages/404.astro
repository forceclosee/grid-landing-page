---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Page Not Found">
	<main class="flex flex-col justify-center items-center p-8 text-center">
		<span class="text-4xl">404</span>
		<h1 class="mbs-8">Page Not Found</h1>
		<p class="mbs-12">
			The page you are looking for doesn't exist. Click button bellow to go to
			the homepage
		</p>
		<a
			class="inline-block bg-black/30 hover:bg-black/40 px-4 py-2 rounded-lg active:scale-95 transition-all duration-200 squircle mbs-8"
			href="/"
			>Back To Homepage</a
		>
	</main>
</Layout>
