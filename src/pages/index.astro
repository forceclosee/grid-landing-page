---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/hero/Hero.astro";
import Stats from "@components/stats/Stats";
---

<Layout title="Grid Landing Page | ForceClose">
	<main
		id="main"
		class="inline-full max-inline-[90rem] content-start lg:content-stretch grid lg:grid-cols-[4fr_5fr] mx-auto">
		<Hero />
		<Stats client:load />
	</main>
</Layout>
