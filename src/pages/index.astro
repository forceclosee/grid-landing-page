---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/hero/Hero.astro";
import Stats from "@components/stats/Stats";
import { actions } from "astro:actions";
import CardSkeleton from "@components/loaders/CardSkeleton";

// prefetch data on server side at request time
const { data } = await Astro.callAction(actions.getStats, {});
---

<Layout title="Grid Landing Page | ForceClose">
	<main
		id="main"
		class="inline-full max-inline-[90rem] content-start lg:content-stretch grid lg:grid-cols-[4fr_5fr] mx-auto">
		<Hero />

		{null /* hydrate Stats component dynamically based on prefetch status */}
		{data 
		? <Stats client:load data={data}/> 
		: <Stats client:only="solid-js">
			<div
				slot="fallback"
				class="inline-full max-inline-[26rem] md:max-inline-[50rem] grid md:grid-cols-[1fr_1fr] mx-auto">
				<CardSkeleton />
				<CardSkeleton />
				<CardSkeleton />
				<CardSkeleton />
			</div>
		</Stats>}
	</main>
</Layout>
