---
import { Font } from "astro:assets";

import Footer from "@components/footer/Footer.astro";

import "@styles/global.css";

type Props = {
	title: string;
};
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-blue-700">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<meta name="theme-color" content="#212529">

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="author" content="Force Close">
		<meta name="description" content="">
		<meta name="keywords" content="Force Close, ">

		<!-- OG Tags -->
		<meta property="og:title" content={title}>
		<meta property="og:description" content="">
		<meta property="og:image" content="">
		<!-- isi image -->
		<meta property="og:url" content="">
		<!-- isi live site url -->
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="Force Close Portfolio">

		<!-- font -->
		<Font cssVariable="--font-inter" />

		<!-- favicon -->
		<link rel="icon" href="/icon.svg" type="image/svg+xml">
	</head>
	<body class="text-white">
		<div class="min-block-svh grid grid-rows-[auto_1fr_auto]">
			<header>asdddd</header>
			<slot />
			<Footer />
		</div>
	</body>
</html>
