---
import { Font } from "astro:assets";

import Header from "@components/header/Header.astro";
import Footer from "@components/footer/Footer.astro";

import "@styles/global.css";

type Props = {
	title: string;
};
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-blue-700">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<meta name="theme-color" content="#2a54fe">

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="author" content="Force Close">
		<meta
			name="description"
			content="We fund schools, train teachers, and measure what works to ensure every child we reach today becomes a graduate tomorrow. Explore our responsive stats dashboard.">

		<!-- OG Tags -->
		<meta
			property="og:title"
			content="Grid Landing Page - a responsive fluid layout landing page">
		<meta
			property="og:description"
			content="We fund schools, train teachers, and measure what works to ensure every child we reach today becomes a graduate tomorrow. Explore our responsive stats dashboard.">
		<meta
			property="og:image"
			content="https://res.cloudinary.com/dspqgpnvq/image/upload/v1786421367/grid-landing-page_pg0zsn.png">
		<meta
			property="og:url"
			content="https://grid-landing-page.forceclose.workers.dev/">
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="Force Close Portfolio">

		<!-- font -->
		<Font cssVariable="--font-inter" />

		<!-- favicon -->
		<link rel="icon" href="/icon.svg" type="image/svg+xml">
	</head>
	<body class="text-white">
		<div class="min-block-svh grid grid-rows-[auto_1fr_auto]">
			<Header />
			<slot />
			<Footer />
		</div>
	</body>
</html>
